{
  "name": "brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun run fetch-model && bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run fetch-model && bun build src/main.ts src/embed/thread.ts --compile --outfile dist/brain.new && mv -f dist/brain.new dist/brain",
    "fetch-model": "bun run scripts/fetch-model.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.2",
    "@effect/sql-pg": "4.0.2",
    "@effect/sql-pglite": "4.0.2",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@huggingface/tokenizers": "0.2.0",
    "effect": "4.0.2",
    "effect-qb": "0.24.1",
    "onnxruntime-web": "1.30.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "5"
  }
}
