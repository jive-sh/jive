{
  "$schema": "./.github/json-schema.json",
  "name": "@jive-sh/jive",
  "module": "src/index.ts",
  "type": "module",
  "description": "The Jive CLI",
  "license": "MIT",
  "version": "0.0.1",
  "bin": {
    "jive": "bin/jive",
    "git-credential-jive": "bin/git-credential-jive"
  },
  "scripts": {
    "jive:cicd:get-config": "bun src/scripts/get-cicd-config.ts",
    "build:watch": "",
    "build": "bun build --compile src/index.ts --outfile build/jive && bun build --compile src/git-credential-helper.ts --outfile build/git-credential-jive && bun ./src/temp-libs/cli-template/copy-package-json.ts",
    "deploy": "echo 'No custom deploy logic'",
    "test:integration": "",
    "test:unit": "tsc --noEmit -p tsconfig.json && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "20.x",
    "typescript": "^5"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0",
    "bun": "^1.3.0",
    "effect": "^4.0.0",
    "effective-modules": "0.3.1-effect4",
    "git-url-parse": "^16.1.0",
    "javascript-time-ago": "^2.6.4",
    "jive-abstract-library": "^0.6.1",
    "oauth2-cli": "^2.0.0"
  },
  "workspaces": [
    "./effect/packages/*",
    "./"
  ],
  "jive": {
    "cicd": {
      "deployBranches": {
        "main": ["Production"]
      },
      "runOnPullRequests": true,
      "enablePreviewDeploys": false
    }
  }
}
