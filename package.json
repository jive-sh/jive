{
  "$schema": "./package.schema.json",
  "name": "@jive-sh/jive",
  "version": "0.6.0",
  "license": "MIT",
  "description": "The Jive CLI: signs you in to Jive, signs your git commits and GitHub pushes with your account's key on the Jive server, loads repos into a workspace, and answers the Jive browser extension.",
  "type": "module",
  "scripts": {
    "jive:cicd:get-config": "jive-library cicd get-config",
    "jive:cicd:build": "jive-library cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && bun test src",
    "jive:cicd:deploy:plan": "jive-library cicd deploy-plan",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "jive-library cicd deploy",
    "build:local": "bun ../../jive-abstract-library/src/entrypoints/jive-library.ts cicd build",
    "install:local": "bun run build:local && bun uninstall --global @jive-sh/jive ; bun add -g \"$(pwd)/dist/base\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0",
    "@jive-sh/server-client": "0.12.0",
    "convex": "^1.48.0",
    "effect": "^4.0.0",
    "effective-modules": "0.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "jive-abstract-library": "0.13.1",
    "typescript": "^5.9.3"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "requiredSecrets": [
        "NPM_TOKEN"
      ],
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest"
    },
    "library": {
      "daemons": [
        "jive-extension-daemon",
        "jive-signing-agent"
      ],
      "provisionWithJive": null
    }
  }
}
